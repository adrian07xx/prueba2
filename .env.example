# Copia este archivo como .env (local con `netlify dev`) o configura estas
# variables como Environment Variables en el dashboard de Netlify.
# NUNCA subas tu .env real ni claves reales a git.

# Clave secreta de Stripe (modo TEST mientras desarrollas). Empieza por sk_test_...
# Se usa SOLO en la función serverless (netlify/functions/create-checkout-session.js),
# nunca se expone al navegador.
STRIPE_SECRET_KEY=sk_test_your_test_secret_key_here

# URL pública del sitio, usada para construir success_url/cancel_url de Stripe
# y las URLs de imagen de los productos. En local con `netlify dev` suele ser
# http://localhost:8888. En producción, la URL de tu sitio en Netlify.
SITE_URL=https://tu-tienda.netlify.app
